# MatchRoom env — all optional. The seeded demo + the request-demo form both
# work with NO keys set (form stores submissions locally and returns success).

# Live agent mode (POST /api/demo-brief) uses this if present; else falls back to seeded.
OPENAI_API_KEY=

# Request-a-demo form email delivery (POST /api/request-demo). If RESEND_API_KEY
# is unset, submissions are still stored locally and the form succeeds.
RESEND_API_KEY=
REQUEST_DEMO_TO=carther91@gmail.com
RESEND_FROM=MatchRoom <onboarding@resend.dev>
